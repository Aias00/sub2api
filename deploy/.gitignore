data/
data_cloudbase/
postgres_data/
postgres_data.backup-*/
postgres_data_cloudbase/
redis_data/
redis_data_cloudbase/
runtime/
runtime_cloudbase/
hot/

# Environment configuration (contains sensitive information)
.env

# Backup files
*.backup
*.bak

# Temporary files
*.tmp
*.log
