[Unit]
Description=Cloudbase Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=cloudbase
Group=cloudbase
WorkingDirectory=/opt/cloudbase
ExecStart=/opt/cloudbase/datamanagementd \
  -socket-path /tmp/cloudbase-datamanagement.sock \
  -sqlite-path /var/lib/cloudbase/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
