[Unit]
Description=Cloudbase - AI API Gateway Platform
Documentation=https://github.com/Wei-Shaw/cloudbase
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=cloudbase
Group=cloudbase
WorkingDirectory=/opt/cloudbase
ExecStart=/opt/cloudbase/cloudbase
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cloudbase

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/cloudbase

# Environment - Server configuration
# Modify these values to change listen address and port
Environment=GIN_MODE=release
Environment=SERVER_HOST=0.0.0.0
Environment=SERVER_PORT=8080

[Install]
WantedBy=multi-user.target
